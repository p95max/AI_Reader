AI_READER_APP_NAME="AI Reader API"
AI_READER_ENVIRONMENT="local"
AI_READER_DEBUG=true
AI_READER_DATABASE_URL="postgresql+psycopg://ai_reader:ai_reader@localhost:5433/ai_reader"
AI_READER_DATABASE_ECHO=false
AI_READER_REDIS_URL="redis://localhost:6379/0"
AI_READER_CELERY_BROKER_URL="redis://localhost:6379/1"
AI_READER_CELERY_RESULT_BACKEND="redis://localhost:6379/2"
AI_READER_S3_ENDPOINT_URL="http://localhost:9000"
AI_READER_S3_ACCESS_KEY_ID="minioadmin"
AI_READER_S3_SECRET_ACCESS_KEY="minioadmin"
AI_READER_S3_BUCKET_NAME="ai-reader"
AI_READER_S3_REGION_NAME="us-east-1"
AI_READER_MAX_PDF_SIZE_BYTES="104857600"
AI_READER_OPENAI_API_KEY=""
AI_READER_AI_MODEL="gpt-5.6-luna"
AI_READER_AI_TIMEOUT_SECONDS="45"
AI_READER_AI_MAX_ATTEMPTS="3"
AI_READER_AI_RETRY_WAIT_SECONDS="1"
AI_READER_AI_RETRY_MAX_WAIT_SECONDS="8"
AI_READER_AI_INPUT_COST_PER_MILLION_TOKENS="0"
AI_READER_AI_CACHED_INPUT_COST_PER_MILLION_TOKENS="0"
AI_READER_AI_OUTPUT_COST_PER_MILLION_TOKENS="0"
AI_READER_NARRATION_CACHE_TTL_SECONDS="604800"
AI_READER_TTS_PROVIDER="qwen"
AI_READER_TTS_MODEL="Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice"
AI_READER_TTS_DEVICE="cpu"
AI_READER_TTS_VOICE="Ryan"
AI_READER_TTS_LANGUAGE="Russian"
AI_READER_TTS_INSTRUCTION="Говори ясно, естественно и спокойно."
AI_READER_TTS_CHUNK_MAX_CHARACTERS="1200"
AI_READER_TTS_MAX_ATTEMPTS="3"
AI_READER_PROGRESSIVE_PRIORITY_CHAPTER_COUNT="2"
AI_READER_PLAYBACK_MIN_READY_DURATION_SECONDS="600"

POSTGRES_DB="ai_reader"
POSTGRES_USER="ai_reader"
POSTGRES_PASSWORD="ai_reader"
POSTGRES_PORT="5433"
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"
