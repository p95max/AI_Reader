AI_READER_APP_NAME="AI Reader API"
AI_READER_ENVIRONMENT="local"
AI_READER_DEBUG=true
AI_READER_DATABASE_URL="postgresql+psycopg://ai_reader:ai_reader@localhost:5433/ai_reader"
AI_READER_DATABASE_ECHO=false
AI_READER_REDIS_URL="redis://localhost:6379/0"
AI_READER_CELERY_BROKER_URL="redis://localhost:6379/1"
AI_READER_CELERY_RESULT_BACKEND="redis://localhost:6379/2"
AI_READER_S3_ENDPOINT_URL="http://localhost:9000"
AI_READER_S3_ACCESS_KEY_ID="minioadmin"
AI_READER_S3_SECRET_ACCESS_KEY="minioadmin"
AI_READER_S3_BUCKET_NAME="ai-reader"
AI_READER_S3_REGION_NAME="us-east-1"
AI_READER_MAX_PDF_SIZE_BYTES="104857600"

POSTGRES_DB="ai_reader"
POSTGRES_USER="ai_reader"
POSTGRES_PASSWORD="ai_reader"
POSTGRES_PORT="5433"
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"
MINIO_API_PORT="9000"
MINIO_CONSOLE_PORT="9001"
